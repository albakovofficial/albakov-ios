<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push-уведомления (APNs). Здесь development — при выгрузке в TestFlight/App Store Xcode сам ставит production. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Ссылки albakovofficial.ru открываются сразу в приложении (файл apple-app-site-association отдаёт сайт). -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:albakovofficial.ru</string>
		<!-- Пароли от albakovofficial.ru из «Связки ключей» подставляются в форму входа. -->
		<string>webcredentials:albakovofficial.ru</string>
	</array>
</dict>
</plist>
